{
  "id": "rumble_shock",
  "name": "手柄震动联动",
  "version": "1.2.0",
  "sdk": "1",
  "author": "你的名字",
  "description": "监听游戏手柄震动并自动映射为电击",
  "entry": "rumble_shock.exe",
  "capabilities": {
    "startup_check": true
  },
  "config_schema": [
    {
      "section": "基础设置",
      "fields": [
        {
          "key": "process_name",
          "type": "text",
          "label": "游戏进程名",
          "default": "OuterWilds.exe",
          "description": "要监听的游戏进程名称"
        },
        {
          "key": "preset",
          "type": "preset",
          "label": "波形预设",
          "default": "CS2-受伤"
        }
      ]
    },
    {
      "section": "震动映射",
      "fields": [
        {
          "key": "min_rumble",
          "type": "number",
          "label": "最小震动阈值",
          "default": 800,
          "min": 0,
          "max": 65535,
          "step": 50,
          "description": "低于此值的震动将被忽略"
        },
        {
          "key": "strength_scale",
          "type": "number",
          "label": "强度缩放比例",
          "default": 75,
          "min": 10,
          "max": 200,
          "step": 5,
          "description": "震动强度映射到电击强度的比例"
        },
        {
          "key": "cooldown",
          "type": "duration",
          "label": "冷却时间（秒）",
          "default": 0.45,
          "min": 0.1,
          "max": 5.0,
          "step": 0.05
        },
        {
          "key": "duration",
          "type": "duration",
          "label": "电击持续时间（秒）",
          "default": 0.65,
          "min": 0.1,
          "max": 5.0,
          "step": 0.05
        }
      ]
    }
  ]
}